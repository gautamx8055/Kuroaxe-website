---
interface Props {
  tone?: "light" | "dark";
  class?: string;
}

const { tone = "light", class: className = "" } = Astro.props;
const ink = tone === "dark";
---

<svg
  class:list={["scribble-layer", className]}
  viewBox="0 0 1440 920"
  fill="none"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid slice"
  data-tone={tone}
>
  <path
    d="M1188 72 C1294 28, 1398 96, 1354 188 C1306 274, 1178 228, 1168 148 C1158 86, 1230 78, 1272 118"
    stroke={ink ? "#EBFF3D" : "#20D9C2"}
    stroke-width="8"
    stroke-linecap="round"
  />
  <path
    d="M1210 96 C1288 70, 1348 112, 1326 168"
    stroke={ink ? "#FF6B35" : "#EBFF3D"}
    stroke-width="4"
    stroke-linecap="round"
  />
  <path
    d="M1224 620 C1290 560, 1378 582, 1408 668"
    stroke="#20D9C2"
    stroke-width="7"
    stroke-linecap="round"
  />
  <path
    d="M1374 646 L1408 668 L1382 702"
    stroke="#20D9C2"
    stroke-width="7"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M86 708 L102 748 L146 754 L112 782 L120 826 L86 802 L52 826 L60 782 L26 754 L70 748 Z"
    fill="#FF6B35"
  />
  <path
    d="M96 760 C108 748, 124 762, 112 776 C100 790, 86 774, 96 760"
    stroke="#EBFF3D"
    stroke-width="3"
    stroke-linecap="round"
  />
  <circle cx="248" cy="96" r="9" fill={ink ? "#FF6B35" : "#EBFF3D"} />
  <circle cx="272" cy="118" r="4.5" fill={ink ? "#EBFF3D" : "#FF6B35"} />
  <circle cx="1364" cy="784" r="12" fill={ink ? "#FF6B35" : "#FF6B35"} />
  <circle cx="1388" cy="808" r="5" fill="#EBFF3D" />
  <path
    d="M1328 284 C1354 256, 1322 228, 1294 248 C1264 270, 1304 312, 1344 292 C1368 280, 1360 252, 1338 258"
    stroke="#FF6B35"
    stroke-width="5.5"
    stroke-linecap="round"
  />
  <path
    d="M980 120 L1004 112 L1012 88 L1020 112 L1044 120 L1020 128 L1012 152 L1004 128 Z"
    fill="#EBFF3D"
  />
  <path
    d="M70 430 C92 404, 128 448, 102 470"
    stroke="#20D9C2"
    stroke-width="5"
    stroke-linecap="round"
  />
  <path
    d="M1088 860 C1160 820, 1288 848, 1340 900"
    stroke={ink ? "#FF6B35" : "#EBFF3D"}
    stroke-width="6"
    stroke-linecap="round"
    opacity="0.85"
  />
  <path
    d="M48 180 C120 140, 200 210, 160 250"
    stroke="#FF6B35"
    stroke-width="5"
    stroke-linecap="round"
  />
</svg>
