---
import { nav, site } from "../content/site";
import Mark from "./Mark.astro";

const raw = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  if (href.includes("#")) return false;
  if (href === "/services") return raw === "/services" || raw.startsWith("/services/");
  return raw === href;
}
---

<header class="glass-nav sticky top-0 z-50">
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 bg-gilt" data-page-progress aria-hidden="true"></div>
  <div class="shell flex h-[var(--header-h)] items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-3 text-ivory" data-astro-prefetch>
      <span
        class="flex h-9 w-9 items-center justify-center text-gilt transition-colors duration-300 group-hover:text-ivory"
      >
        <Mark class="h-8 w-8" />
      </span>
      <span class="font-display text-[1.35rem] tracking-tight">Kuroaxe</span>
    </a>

    <nav class="hidden items-center gap-9 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "font-sans text-[0.68rem] font-medium uppercase tracking-[0.22em] transition-colors duration-300",
              isActive(item.href) ? "text-gilt" : "text-ivory/80 hover:text-ivory",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
            data-astro-prefetch
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.codeaxes.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-sans text-[0.68rem] font-medium uppercase tracking-[0.22em] text-ivory/80 transition-colors duration-300 hover:text-ivory"
      >
        Codeaxes
        <span class="sr-only">(opens in a new tab)</span>
        <svg class="h-3 w-3" viewBox="0 0 12 12" aria-hidden="true" fill="none">
          <path
            d="M3.5 8.5 8.5 3.5M5 3.5h3.5V7"
            stroke="currentColor"
            stroke-width="1.1"
            stroke-linecap="square"></path>
        </svg>
      </a>
      <a href="/contact" class="btn-ghost !min-h-10 !px-5 !py-2" data-astro-prefetch>Enquire</a>
    </nav>

    <button
      type="button"
      class="inline-flex min-h-11 min-w-11 items-center justify-center text-ivory lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-menu-toggle
    >
      <span class="sr-only">Open menu</span>
      <span class="flex flex-col gap-1.5" aria-hidden="true">
        <span class="block h-px w-6 bg-current"></span>
        <span class="block h-px w-4 bg-current"></span>
      </span>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden bg-ink/96 lg:hidden"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
>
  <div class="flex h-full flex-col px-6 pb-10 pt-24">
    <nav class="flex flex-1 flex-col gap-2" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="font-display text-5xl font-light tracking-[-0.03em] text-ivory"
            data-astro-prefetch
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.codeaxes.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 font-display text-5xl font-light tracking-[-0.03em] text-gilt"
      >
        Codeaxes
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </nav>
    <a href="/contact" class="btn-primary w-full">Grow with Kuroaxe</a>
  </div>
</div>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const menu = document.getElementById("mobile-menu");
  if (toggle instanceof HTMLButtonElement && menu) {
    const label = toggle.querySelector(".sr-only");
    const open = () => {
      menu.hidden = false;
      menu.classList.remove("hidden");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Close menu");
      if (label) label.textContent = "Close menu";
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      menu.hidden = true;
      menu.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");
      if (label) label.textContent = "Open menu";
      document.body.style.overflow = "";
    };
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      expanded ? close() : open();
    });
    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
  }
</script>
