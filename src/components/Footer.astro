---
import { nav, site } from "../content/site";
import { services } from "../content/services";
import Mark from "./Mark.astro";
---

<footer class="relative z-10 bg-ink text-ivory">
  <div class="shell py-16 lg:py-24">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="flex items-center gap-3 text-yellow">
          <Mark class="h-8 w-8" />
          <span class="font-display text-[1.25rem] font-extrabold tracking-tight text-ivory">Kuroaxe</span>
        </a>
        <p class="mt-8 max-w-sm font-display text-3xl font-extrabold leading-tight text-ivory">{site.tagline}</p>
        <p class="mt-6 text-sm text-bone">{site.studios}</p>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-7">
        <div>
          <p class="kicker">House</p>
          <ul class="mt-5 space-y-3 text-sm text-ivory/85">
            {
              nav.map((item) => (
                <li>
                  <a class="transition-colors hover:text-yellow" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                class="inline-flex items-center gap-1 transition-colors hover:text-turquoise"
                href={site.codeaxes.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                Codeaxes
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          </ul>
        </div>
        <div>
          <p class="kicker">Services</p>
          <ul class="mt-5 space-y-3 text-sm text-ivory/85">
            {
              services.map((service) => (
                <li>
                  <a class="transition-colors hover:text-yellow" href={service.href}>
                    {service.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="kicker">Atelier</p>
          <ul class="mt-5 space-y-3 text-sm text-ivory/85">
            <li>
              <a class="transition-colors hover:text-turquoise" href={`mailto:${site.email}`}>{site.email}</a>
            </li>
            <li>
              <a class="transition-colors hover:text-yellow" href={site.phoneHref}>{site.phone}</a>
            </li>
            {
              site.socials.map((social) => (
                <li>
                  <a
                    class="transition-colors hover:text-turquoise"
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {social.label}
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-16 h-px bg-white/10"></div>

    <div class="mt-8 flex flex-col gap-4 text-xs tracking-wide text-bone sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Kuroaxe. All rights reserved.</p>
      <p>{site.codeaxes.note}</p>
      <p class="flex gap-6">
        <a class="hover:text-ivory" href="/privacy">Privacy</a>
        <a class="hover:text-ivory" href="/terms">Terms</a>
      </p>
    </div>
  </div>
</footer>
