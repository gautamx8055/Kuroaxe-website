---
import type { ServiceSlug } from "../content/services";

interface Props {
  slug: ServiceSlug;
  class?: string;
}

const { slug, class: className = "h-6 w-6" } = Astro.props;

const tones: Record<ServiceSlug, string> = {
  seo: "bg-turquoise",
  smm: "bg-yellow text-ink",
  "performance-marketing": "bg-orange",
  "ar-vr": "bg-turquoise",
  graphics: "bg-yellow text-ink",
  "video-production": "bg-turquoise",
};
---

<span class:list={["icon-tile", tones[slug]]}>
  {
    slug === "seo" && (
      <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="6.25" stroke="currentColor" stroke-width="1.8" />
        <path d="M16 16.5 20 20.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    )
  }
  {
    slug === "smm" && (
      <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="8" cy="9" r="2.4" stroke="currentColor" stroke-width="1.8" />
        <circle cx="16" cy="8" r="2.1" stroke="currentColor" stroke-width="1.8" />
        <circle cx="13" cy="15.5" r="2.3" stroke="currentColor" stroke-width="1.8" />
        <path d="M9.8 10.6 14.4 9.2M10.2 10.9l2.1 3.4" stroke="currentColor" stroke-width="1.6" />
      </svg>
    )
  }
  {
    slug === "performance-marketing" && (
      <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 16.5 9.2 12l3.2 3.1L19 8.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M14.5 8.5H19V13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    )
  }
  {
    slug === "ar-vr" && (
      <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="4" y="8" width="16" height="9" rx="3.5" stroke="currentColor" stroke-width="1.8" />
        <path d="M10 12.5h.01M14 12.5h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
      </svg>
    )
  }
  {
    slug === "graphics" && (
      <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 18 12 5l7 13H5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    slug === "video-production" && (
      <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="4" y="7" width="12" height="10" rx="2" stroke="currentColor" stroke-width="1.8" />
        <path d="M16 10.5 20 8.5v7l-4-2v-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      </svg>
    )
  }
</span>
