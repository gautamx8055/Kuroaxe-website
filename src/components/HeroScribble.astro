---
/**
 * Hand-drawn jazz marks over the hero still.
 * Corner-anchored so paths keep their shape (no stretched geometry).
 */
---

<div class="hero-scribble-overlay" aria-hidden="true">
  <svg class="mark mark-swash" viewBox="0 0 560 220" fill="none" overflow="visible">
    <path
      d="M4 176 C48 64, 150 8, 268 46 C348 76, 410 58, 502 22 C528 12, 548 18, 556 34"
      stroke="#EBFF3D"
      stroke-width="14"
      stroke-linecap="round"
    />
    <path
      d="M18 192 C64 86, 164 28, 278 66 C346 92, 398 74, 468 44"
      stroke="#EBFF3D"
      stroke-width="5"
      stroke-linecap="round"
      opacity="0.7"
    />
    <circle cx="96" cy="28" r="6" fill="#FF6B35" />
    <circle cx="114" cy="44" r="3" fill="#EBFF3D" />
  </svg>

  <svg class="mark mark-loop" viewBox="0 0 260 240" fill="none" overflow="visible">
    <path
      d="M38 92 C86 12, 214 28, 228 118 C236 178, 164 204, 118 168 C78 136, 92 78, 154 70 C198 64, 228 102, 214 138"
      stroke="#20D9C2"
      stroke-width="7.5"
      stroke-linecap="round"
    />
    <path
      d="M70 108 C112 52, 186 72, 192 128"
      stroke="#EBFF3D"
      stroke-width="3.4"
      stroke-linecap="round"
    />
    <path
      d="M206 18 L218 14 L224 2 L228 16 L242 22 L226 26 L220 40 L216 24 Z"
      fill="#EBFF3D"
    />
  </svg>

  <svg class="mark mark-star" viewBox="0 0 170 170" fill="none" overflow="visible">
    <path
      d="M86 8 L102 54 L154 48 L114 86 L132 138 L82 112 L36 146 L52 90 L8 66 L62 58 Z"
      fill="#FF6B35"
    />
    <path
      d="M72 74 C86 58, 110 74, 96 92 C84 106, 64 90, 72 74"
      stroke="#EBFF3D"
      stroke-width="3"
      stroke-linecap="round"
    />
  </svg>

  <svg class="mark mark-coil" viewBox="0 0 240 250" fill="none" overflow="visible">
    <path
      d="M28 96 C22 28, 92 -8, 168 22 C228 48, 252 124, 214 184 C178 240, 92 252, 48 208 C16 174, 18 118, 70 98 C110 84, 150 108, 142 150 C136 182, 104 190, 88 162 C78 142, 96 128, 118 136"
      stroke="#FF8A3D"
      stroke-width="8"
      stroke-linecap="round"
    />
    <path
      d="M92 140 C104 118, 138 122, 142 148"
      stroke="#FF6B35"
      stroke-width="4"
      stroke-linecap="round"
    />
  </svg>
</div>

<style>
  .hero-scribble-overlay {
    position: absolute;
    inset: 0;
    z-index: 30;
    overflow: visible;
    pointer-events: none;
    transform: rotate(1deg);
  }

  .mark {
    position: absolute;
    overflow: visible;
    display: block;
  }

  .mark-swash {
    top: -2.1rem;
    left: -2.4rem;
    width: min(58%, 28rem);
    height: auto;
  }

  .mark-loop {
    top: -2.4rem;
    right: -1.8rem;
    width: min(32%, 15rem);
    height: auto;
  }

  .mark-star {
    bottom: -1.8rem;
    left: -2.2rem;
    width: min(20%, 8.75rem);
    height: auto;
    transform: rotate(-14deg);
  }

  .mark-coil {
    bottom: -2.4rem;
    right: -2.2rem;
    width: min(28%, 13.5rem);
    height: auto;
  }
</style>
