---
import JazzScribble from "./JazzScribble.astro";

interface Props {
  kicker?: string;
  title: string;
  body?: string;
  href?: string;
  cta?: string;
  theme?: "ink" | "ivory";
}

const {
  kicker = "Private enquiry",
  title,
  body,
  href = "/contact",
  cta = "Grow with Kuroaxe",
  theme = "ink",
} = Astro.props;
---

<section class:list={[theme === "ivory" ? "theme-ivory relative" : "relative overflow-hidden bg-turquoise text-ink"]}>
  {
    theme !== "ivory" && (
      <>
        <div class="pointer-events-none absolute -right-16 top-10 h-72 w-72 rounded-full bg-yellow/30 blur-3xl" aria-hidden="true" />
        <JazzScribble tone="dark" />
      </>
    )
  }
  {
    theme === "ivory" && (
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <JazzScribble />
      </div>
    )
  }
  <div class="shell relative z-10 py-24 lg:py-32">
    <div class="grid items-end gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class:list={[theme === "ivory" ? "kicker-ink" : "kicker-dark"]}>{kicker}</p>
        <h2 class="display mt-6 text-5xl text-current sm:text-6xl lg:text-7xl">{title}</h2>
        {
          body && (
            <p class:list={["mt-6 max-w-xl text-base", theme === "ivory" ? "text-ink/70" : "text-ink/75"]}>{body}</p>
          )
        }
      </div>
      <div class="lg:col-span-4 lg:justify-self-end">
        <a class:list={[theme === "ivory" ? "btn-ink" : "btn-primary"]} href={href}>{cta}</a>
      </div>
    </div>
  </div>
</section>
