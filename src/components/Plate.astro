---
import type { Plate as PlateType } from "../content/work";
import AtelierStill from "./AtelierStill.astro";

interface Props {
  plate: PlateType;
  layout?: "bleed" | "split" | "split-reverse";
}

const { plate, layout = "split" } = Astro.props;
---

<article
  class:list={[
    "group",
    layout === "bleed" && "relative",
    layout !== "bleed" && "grid items-stretch gap-0 lg:grid-cols-12",
  ]}
>
  <div
    class:list={[
      layout === "bleed" && "min-h-[72vh]",
      layout === "split" && "lg:col-span-7",
      layout === "split-reverse" && "lg:col-span-7 lg:order-2",
    ]}
  >
    <AtelierStill
      variant={plate.still}
      caption={layout === "bleed" ? `${plate.folio}  ·  ${plate.sector}` : undefined}
      class={`h-full w-full ${layout === "bleed" ? "min-h-[72vh]" : "min-h-[28rem] lg:min-h-[36rem]"}`}
    />
  </div>

  <div
    class:list={[
      layout === "bleed"
        ? "absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink via-ink/85 to-transparent p-6 sm:p-10 lg:p-16"
        : "flex flex-col justify-end bg-charcoal p-8 sm:p-10 lg:col-span-5 lg:p-12",
      layout === "split-reverse" && "lg:order-1",
    ]}
  >
    <p class="kicker">{plate.folio} — {plate.client}</p>
    <h3 class="display mt-5 max-w-xl text-4xl sm:text-5xl">{plate.title}</h3>
    <p class="mt-6 max-w-md text-sm leading-relaxed text-bone">{plate.narrative}</p>
    <dl class="mt-8 grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="kicker">Channels</dt>
        <dd class="mt-2 text-sm text-ivory/90">{plate.channels.join(" · ")}</dd>
      </div>
      <div>
        <dt class="kicker">{plate.metricLabel}</dt>
        <dd class="mt-2 font-display text-4xl text-gilt">{plate.metric}</dd>
      </div>
    </dl>
    <p class="mt-6 max-w-md text-sm text-ivory/80">{plate.outcome}</p>
  </div>
</article>
