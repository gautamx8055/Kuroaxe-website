---
interface Props {
  items: { question: string; answer: string }[];
  ink?: boolean;
}

const { items, ink = false } = Astro.props;
---

<div class="divide-y divide-white/15">
  {
    items.map((item) => (
      <details class="group py-6">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-left">
          <span class="font-display text-2xl font-extrabold leading-snug sm:text-3xl">{item.question}</span>
          <span
            class:list={[
              "mt-2 flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-lg leading-none",
              ink ? "bg-turquoise text-ink" : "bg-yellow text-ink",
            ]}
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p class:list={["mt-4 max-w-2xl text-sm leading-relaxed", ink ? "text-ink/70" : "text-bone"]}>
          {item.answer}
        </p>
      </details>
    ))
  }
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
