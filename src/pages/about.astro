---
import BaseLayout from "../layouts/BaseLayout.astro";
import AtelierStill from "../components/AtelierStill.astro";
import CtaBand from "../components/CtaBand.astro";
import { about } from "../content/about";
import { home } from "../content/home";
import { organizationGraph } from "../lib/schema";
---

<BaseLayout
  title="About"
  description="Kuroaxe is a premium creative growth house: strategists, designers, marketers, and makers under one editorial standard."
  path="/about"
  jsonLd={organizationGraph()}
>
  <section class="relative min-h-[88svh] overflow-hidden" data-hero>
    <div class="absolute inset-0" data-hero-frame>
      <AtelierStill variant="graphics" caption="" class="h-full min-h-[88svh] w-full" />
      <div class="hero-veil"></div>
    </div>
    <div class="shell relative z-10 flex min-h-[88svh] flex-col justify-end py-16 lg:py-24">
      <p class="kicker">{about.kicker}</p>
      <h1 class="display mt-6 max-w-5xl text-5xl sm:text-7xl lg:text-8xl">
        <span class="clip"><span class="block" data-hero-line>{about.heroLine}</span></span>
      </h1>
      <p class="mt-10 max-w-2xl font-display text-2xl italic leading-snug text-ivory/85">{about.mission}</p>
    </div>
  </section>

  <section class="theme-ivory">
    <div class="shell grid gap-12 py-24 lg:grid-cols-12 lg:py-32">
      <p class="kicker-ink lg:col-span-3">Story</p>
      <div class="prose-luxe text-ink/80 lg:col-span-8">
        {about.story.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section>
    <div class="shell py-24 lg:py-32">
      <p class="kicker">Values</p>
      <h2 class="display mt-5 max-w-3xl text-4xl sm:text-5xl">Five words we will not use as decoration.</h2>
      <ul class="mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-5">
        {
          about.values.map((value) => (
            <li>
              <h3 class="font-display text-3xl">{value.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-bone">{value.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-charcoal">
    <div class="shell grid gap-12 py-24 lg:grid-cols-12 lg:py-32">
      <div class="lg:col-span-5">
        <p class="kicker">Philosophy</p>
        <h2 class="display mt-5 text-4xl sm:text-5xl">Creative meets performance in the edit.</h2>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="text-base leading-relaxed text-bone">{about.philosophy}</p>
        <ul class="mt-10 space-y-4">
          {
            about.whyClients.map((item) => (
              <li class="border-t border-gilt/20 pt-4 text-sm leading-relaxed text-ivory/85">{item}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section>
    <div class="shell py-24 lg:py-32">
      <p class="kicker">Roster</p>
      <h2 class="display mt-5 max-w-3xl text-5xl">The people in the pitch stay on the work.</h2>
      <ul class="mt-16 grid gap-px bg-gilt/15 sm:grid-cols-2 lg:grid-cols-3">
        {
          about.team.map((person) => (
            <li class="bg-ink p-8 lg:p-10">
              <span class="flex h-14 w-14 items-center justify-center border border-gilt/40 font-display text-lg text-gilt">
                {person.initials}
              </span>
              <p class="mt-6 font-display text-2xl">{person.name}</p>
              <p class="kicker mt-2">{person.role}</p>
              <p class="mt-4 text-sm leading-relaxed text-bone">{person.bio}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-xs text-bone">{about.note}</p>
    </div>
  </section>

  <section class="border-y border-gilt/15">
    <div class="shell py-16">
      <p class="kicker">Selected houses</p>
      <ul class="mt-8 grid grid-cols-2 gap-y-5 sm:grid-cols-3 lg:grid-cols-6">
        {
          home.trust.marks.map((mark) => (
            <li class="font-display text-2xl italic text-ivory/75">{mark}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title="If the standard fits, write to the house."
    body="A short roster. Long seasons. A strategy session is the usual first step."
  />
</BaseLayout>
