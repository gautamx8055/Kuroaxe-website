---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import JazzScribble from "../components/JazzScribble.astro";
import { contact } from "../content/contact";
import { site } from "../content/site";
import { organizationGraph } from "../lib/schema";
---

<BaseLayout
  title="Contact"
  description="Enquire with Kuroaxe. A strategist replies within two business days. Strategy sessions by appointment."
  path="/contact"
  jsonLd={organizationGraph()}
>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -left-10 top-20 h-72 w-72 rounded-full bg-turquoise/20 blur-3xl"></div>
      <JazzScribble tone="dark" />
    </div>
    <div class="shell hero-stage relative z-10 grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
        <p class="kicker">{contact.kicker}</p>
      <h1 class="display mt-4 text-[clamp(2.2rem,5.4vw,4.8rem)]">{contact.headline}</h1>
      <p class="mt-6 max-w-md text-bone">{contact.lede}</p>

      <dl class="mt-8 space-y-6 text-sm">
        <div>
          <dt class="kicker">Studio</dt>
          <dd class="mt-2">
            <a class="link-gilt scribble-slash" href={`mailto:${site.email}`}>{site.email}</a>
          </dd>
          <dd class="mt-1">
            <a class="text-ivory/80 hover:text-yellow" href={site.phoneHref}>{site.phone}</a>
          </dd>
          <dd class="mt-3 text-bone">{site.studios}</dd>
        </div>
      </dl>

      <ol class="mt-10 space-y-8">
        {
          contact.next.map((step) => (
            <li>
              <p class="kicker">{step.n}</p>
              <h2 class="mt-2 font-display text-3xl font-extrabold">{step.title}</h2>
              <p class="mt-2 max-w-sm text-sm text-bone">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="lg:col-span-7">
      <div class="overflow-hidden rounded-3xl">
        <ContactForm />
      </div>
    </div>
    </div>
  </section>
</BaseLayout>
