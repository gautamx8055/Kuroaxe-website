---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { contact } from "../content/contact";
import { site } from "../content/site";
import { organizationGraph } from "../lib/schema";
---

<BaseLayout
  title="Contact"
  description="Enquire with Kuroaxe. A strategist replies within two business days. Strategy sessions by appointment."
  path="/contact"
  jsonLd={organizationGraph()}
>
  <section class="shell grid gap-16 py-16 lg:grid-cols-12 lg:py-24">
    <div class="lg:col-span-5">
      <p class="kicker">{contact.kicker}</p>
      <h1 class="display mt-6 text-5xl sm:text-6xl lg:text-7xl">
        <span class="clip"><span class="block" data-hero-line>{contact.headline}</span></span>
      </h1>
      <p class="mt-8 max-w-md text-bone">{contact.lede}</p>

      <dl class="mt-12 space-y-6 text-sm">
        <div>
          <dt class="kicker">Studio</dt>
          <dd class="mt-2">
            <a class="link-gilt" href={`mailto:${site.email}`}>{site.email}</a>
          </dd>
          <dd class="mt-1">
            <a class="text-ivory/80 hover:text-gilt" href={site.phoneHref}>{site.phone}</a>
          </dd>
          <dd class="mt-3 text-bone">{site.studios}</dd>
        </div>
      </dl>

      <ol class="mt-14 space-y-8">
        {
          contact.next.map((step) => (
            <li>
              <p class="kicker">{step.n}</p>
              <h2 class="mt-2 font-display text-3xl font-light">{step.title}</h2>
              <p class="mt-2 max-w-sm text-sm text-bone">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="lg:col-span-7">
      <ContactForm />
    </div>
  </section>
</BaseLayout>
